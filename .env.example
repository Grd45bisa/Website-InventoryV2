# ==========================================
# DocuFlow Inventory Multi-Owner V2.4.1
# Environment Variables Example Template
# JANGAN MENYIMPAN NILAI SECRET ASLI DI FILE INI
# ==========================================

# Supabase Public API (Aman untuk Browser / Client Side)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-public

# Supabase Private Service Key (HANYA UNTUK SERVER-SIDE / RPC / BACKGROUND JOBS)
# PERINGATAN: DILARANG KERAS MENGEKSPOS KEY INI KE BROWSER ATAU CLIENT BUNDLE
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-server-only

# Konfigurasi Aplikasi & Hosting
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=id

# Target Staging / Database Isolasi (Untuk pengujian isolasi tenant dan staging)
# PASTIKAN TIDAK MENGARAH KE DATABASE LEGACY
TARGET_ENV=development

# Database Runtime Aktif (Development Lokal Menggunakan SQLite)
DATABASE_DRIVER=sqlite
DATABASE_PATH=data/dev.db
