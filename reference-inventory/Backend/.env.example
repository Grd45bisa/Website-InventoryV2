# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins are supported in production.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Supabase ────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── SMTP (untuk pengiriman email PO) ─────────────────────
# Dibaca langsung oleh services/email.service.js via process.env.
# Jika kosong, email akan di-skip & status = failed (PO tetap tersimpan).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=your-sender-email@domain.com

# ── Cron Worker (retry email gagal) ──────────────────────
# Wajib di-set di Vercel Project Settings agar endpoint
# GET/POST /api/cron/retry-emails bisa diakses. Vercel Cron otomatis
# mengirim header `Authorization: Bearer <CRON_SECRET>`. Untuk cron
# eksternal (cron-job.org dll), set header yang sama secara manual.
# Tanpa nilai ini, endpoint menolak SEMUA request (403).
CRON_SECRET=generate-a-long-random-string
